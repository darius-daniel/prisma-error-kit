{
  "name": "prisma-error-kit",
  "version": "0.0.0",
  "description": "A TypeScript library for handling Prisma errors in a structured and consistent way.",
  "keywords": [
    "prisma",
    "error",
    "typescript"
  ],
  "homepage": "https://github.com/darius-daniel/prisma-error-kit",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write",
    "test": "vitest run --coverage",
    "size": "size-limit"
  },
  "author": "Darius Daniel <dariusdaniel771@gmail.com>",
  "funding": "https://github.com/darius-daniel/prisma-error-kit?sponsor=1",
  "repository": "github:darius-daniel/prisma-error-kit",
  "bugs": {
    "url": "https://github.com/darius-daniel/prisma-error-kit/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "size-limit": [
    {
      "path": "dist/browser.js",
      "limit": "3.5 KB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@prisma/client": "^6.19.3",
    "@size-limit/preset-small-lib": "^8.2.4",
    "@types/node": "^22.18.1",
    "@vitest/coverage-istanbul": "3.2.4",
    "prisma": "^6.19.3",
    "size-limit": "^8.2.4",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0"
  }
}
